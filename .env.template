# ==============================================================================
# PEPTECH® Unified Environment Configuration Template
# Quality. Safety. Precision.
# Copy this file to .env at the root of the repository.
# ==============================================================================

# Supabase Database & API Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=sb_secret_your_supabase_secret_key
DATABASE_URL=postgresql://postgres:password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# CORS Configuration (RegExp)
STORE_CORS=/^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?$|^https:\/\/(?:[a-zA-Z0-9-]+\.)*peptech\.bio$|^https:\/\/docs\.medusajs\.com$/
ADMIN_CORS=/^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?$|^https:\/\/(?:[a-zA-Z0-9-]+\.)*peptech\.bio$|^https:\/\/docs\.medusajs\.com$/
AUTH_CORS=/^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?$|^https:\/\/(?:[a-zA-Z0-9-]+\.)*peptech\.bio$|^https:\/\/docs\.medusajs\.com$/

# Authentication & Security Secrets (At least 32 random characters each)
JWT_SECRET=your_jwt_secret_at_least_32_characters
COOKIE_SECRET=your_cookie_secret_at_least_32_characters
STRIPE_COMMERCE_SIGNING_SECRET=your_signing_secret_at_least_32_characters
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Stripe Payment Gateway
STRIPE_ACCOUNT_ID=acct_your_stripe_account_id
STRIPE_API_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_LIVE_APPROVED=false
STRIPE_STOREFRONT_URL=http://localhost:3000

# Redis Configuration (Use Redis Cloud from redis.io: rediss://default:<password>@<host>:<port>)
REDIS_URL=rediss://default:your_redis_cloud_password@your_endpoint.redislabs.com:6379

# Background Commerce Tick & Subscription Renewal Cron Secret
COMMERCE_CRON_SECRET=your_random_cron_secret_at_least_16_chars

# Email & Notification Delivery (SMTP required for live subscription reminders, receipts & contact inquiries)
STRIPE_EMAIL_HOST=smtp.example.com
STRIPE_EMAIL_PORT=465
STRIPE_EMAIL_USER=notifications@peptech.bio
STRIPE_EMAIL_PASSWORD=your_smtp_password
STRIPE_EMAIL_FROM="PEPTECH Research" <notifications@peptech.bio>
CONTACT_SUPPORT_EMAIL=support@peptech.bio

# Royal Mail Click & Drop Automation (Required for automated label generation)
CLICKANDDROP_AUTH_KEY=your_click_and_drop_api_key
ROYAL_MAIL_CLICK_AND_DROP_URL=https://api.parcel.royalmail.com/api/v1

# Storefront (Next.js) Public Configuration
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_medusa_publishable_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_WHATSAPP_NUMBER=your_whatsapp_phone_number

# Google Tag Manager & Analytics Tracking
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Conversions API (CAPI) & Pixel
META_PIXEL_ID=your_meta_pixel_id
META_CAPI_ACCESS_TOKEN=your_meta_access_token
META_TEST_EVENT_CODE=

# TikTok Events API & Pixel
TIKTOK_PIXEL_ID=your_tiktok_pixel_id
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
